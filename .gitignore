__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/
venv/
.codex-runs/
.claude/
*.log
.DS_Store
.pytest_cache/
.asv/
.coverage
# leitir materialize runtime locks
tests/fixtures/.locks/
# Local score outputs and volatile evidence remain ignored. The deterministic
# dogfood evidence is tracked so a clean checkout can reproduce the published
# assessment; pytest JUnit is intentionally regenerated on every run.
.leitir-score/*
!.leitir-score/evidence/
.leitir-score/evidence/*
!.leitir-score/evidence/benchmark-run.json
!.leitir-score/evidence/benchmark-run-repeat.json
!.leitir-score/evidence/benchmark-run-permuted.json
!.leitir-score/evidence/code-scope.json
!.leitir-score/evidence/coverage.json
!.leitir-score/evidence/global-report.json
!.leitir-score/evidence/mutmut.json
!.leitir-score/evidence/radon-cc.json
!.leitir-score/evidence/radon-mi.json
!.leitir-score/evidence/score-tool-versions.json
!.leitir-score/evidence/performance-runner.json
!.leitir-score/evidence/baseline-asv.json
!.leitir-score/evidence/candidate-asv.json
.leitir-calibration/
