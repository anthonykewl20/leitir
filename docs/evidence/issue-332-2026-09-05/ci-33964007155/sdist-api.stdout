    {
      "docstring": "Representation of distribution metadata.\n\nCompared to :class:`RawMetadata`, this class provides objects representing\nmetadata fields instead of only using built-in types. Any invalid metadata\nwill cause :exc:`InvalidMetadata` to be raised (with a\n:py:attr:`~BaseException.__cause__` attribute as appropriate).",
      "kind": "class",
      "line": 637,
      "name": "Metadata",
      "path": "src/packaging/metadata.py",
      "qualified_name": "src.packaging.metadata.Metadata",
      "signature": "()"
    },
    {
      "docstring": "A dictionary of raw core metadata.\n\nEach field in core metadata maps to a key of this dictionary (when data is\nprovided). The key is lower-case and underscores are used instead of dashes\ncompared to the equivalent core metadata field. Any core metadata field that\ncan be specified multiple times or can hold multiple values in a single\nfield have a key with a plural name. See :class:`Metadata` whose attributes\nmatch the keys of this dictionary.\n\nCore metadata fields that can be specified multiple times are stored as a\nlist or dict depending on which is appropriate for the field. Any fields\nwhich hold multiple values in a single field are stored as a list.",
      "kind": "class",
      "line": 64,
      "name": "RawMetadata",
      "path": "src/packaging/metadata.py",
      "qualified_name": "src.packaging.metadata.RawMetadata",
      "signature": "(TypedDict, total=False)"
